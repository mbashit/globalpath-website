# Where form submissions are forwarded (JSON POST).
# Works with Formspree, Make.com / Zapier webhooks, or your own backend.
# If this is empty in production, forms show an error and point visitors to WhatsApp
# so no enquiry is silently lost.
FORM_FORWARD_URL=

# Public site URL used for SEO (canonical links, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Where form submissions are forwarded (JSON POST).
# Works with Formspree, Make.com / Zapier webhooks, or your own backend.
# Keep empty until a trusted form-delivery provider is selected and tested.
# Without it, production submissions return an error and are not stored.
FORM_FORWARD_URL=

# Paystack: $40 application fee on the eligibility review (/study-abroad).
# SERVER ONLY secret key (sk_test_… for testing, sk_live_… in production).
# USD must be enabled on the Paystack account. Also set the webhook URL in
# Paystack → Settings → API Keys & Webhooks to
#   https://<your-domain>/api/payments/paystack/webhook
# Without the key, the eligibility form shows an error instead of submitting.
PAYSTACK_SECRET_KEY=

# Canonical public site URL. Replace with the official domain when configured.
NEXT_PUBLIC_SITE_URL=https://globalpath-client-review.netlify.app

# Keep review/staging sites out of search indexes. Set true only for the
# approved production domain after launch content and legal review.
NEXT_PUBLIC_ALLOW_INDEXING=false

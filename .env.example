# Where form submissions are forwarded (JSON POST).
# Works with Formspree, Make.com / Zapier webhooks, or your own backend.
# Keep empty until a trusted form-delivery provider is selected and tested.
# Without it, production submissions return an error and are not stored.
FORM_FORWARD_URL=

# Paystack: $40 application fee on the eligibility review (/study-abroad).
# SERVER ONLY secret key (sk_test_… for testing, sk_live_… in production).
# USD must be enabled on the Paystack account. Also set the webhook URL in
# Paystack → Settings → API Keys & Webhooks to
#   https://<your-domain>/api/payments/paystack/webhook
# Without the key, the eligibility form shows an error instead of submitting.
PAYSTACK_SECRET_KEY=

# Canonical public site URL. Replace with the official domain when configured.
NEXT_PUBLIC_SITE_URL=https://globalpath-client-review.netlify.app

# ---- Student portal (Supabase) -------------------------------------------
# Leave empty to keep the portal switched off; the public site is unaffected.
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (or legacy "anon") key – safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret / service_role key – SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: generic "you have an update" emails for portal events (Resend).
# Without these, students still get in-app notifications.
RESEND_API_KEY=
PORTAL_EMAIL_FROM=

# Malware scanning for uploads (see scanner/README.md). Receives the file bytes
# (POST, application/octet-stream) and must reply {"clean": true|false}.
# If set and unreachable, uploads are refused (fail closed).
MALWARE_SCAN_URL=
MALWARE_SCAN_TOKEN=
# true = refuse all uploads while MALWARE_SCAN_URL is unset. Use in production.
MALWARE_SCAN_REQUIRED=

# Keep review/staging sites out of search indexes. Set true only for the
# approved production domain after launch content and legal review.
NEXT_PUBLIC_ALLOW_INDEXING=false
